{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omega preparation fixture bundle, not a runtime wire schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "provenance", "execution_status", "cases"],
  "properties": {
    "$schema": {"const": "first-slice-cases.schema.json"},
    "schema_version": {"const": 1},
    "provenance": {"type": "string", "minLength": 1},
    "execution_status": {"const": "fixture_only_not_run_against_application"},
    "cases": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "planned_case_refs", "assumptions", "initial", "steps", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^FX[0-9]{2}$"},
        "kind": {"enum": ["cash_ledger", "shared_reservation", "pause_late_fill", "all_recording_unavailable", "mixed_recovery_gates", "intrabar_routes", "no_retroactive_fill", "external_position_control"]},
        "planned_case_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+[0-9]{2}$"}},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "initial": {"type": "object", "minProperties": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["event"], "properties": {"event": {"type": "string", "minLength": 1}, "expected": {"type": "object", "minProperties": 1}}}},
        "expected": {"type": "object", "minProperties": 1}
      }
    }
  }
}
