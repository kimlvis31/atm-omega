            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "type": "object",
              "title": "TEF parameters",
              "properties": {
                "alpha": {
                  "type": "number",
                  "default": 1.0,
                  "minimum": 0.0001,
                  "maximum": 5.0
                },
                "beta": {
                  "type": "number",
                  "default": 1.0,
                  "minimum": 1.0,
