{
  "schema_version": 1,
  "api_version": "1",
  "module_id": "tef",
  "label": "TEF",
  "description": "TEF models, margin allocation, entry/resize/reversal and local stop/reentry policy.",
  "factory": "omega.strategies.tef.module:create",
  "validation_entry": "omega.application.conformance:validate_tef",
  "models": [
    "BSCALPHA",
    "BSCBETA",
    "CGALPHA",
    "MMACDDEFAULT",
    "PATHFINDER",
    "SPDDEFAULT"
  ],
  "default_configuration": {
    "model": "MMACDDEFAULT"
  },
  "configuration_schema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "title": "TEF function",
        "enum": [
          "BSCALPHA",
          "BSCBETA",
          "CGALPHA",
          "MMACDDEFAULT",
          "PATHFINDER",
          "SPDDEFAULT"
        ],
        "default": "MMACDDEFAULT"
      },
      "direction": {
        "type": "string",
        "title": "Direction",
        "enum": [
          "BOTH",
          "LONG",
          "SHORT"
        ],
        "default": "BOTH"
      },
      "order_type": {
        "type": "string",
        "title": "Order type",
        "enum": [
          "MARKET",
          "LIMIT",
          "ADAPTIVE"
        ],
        "default": "MARKET"
      },
      "order_offset": {
        "type": "string",
        "title": "Order offset (%)",
        "default": "0",
        "x-display-percent": true
      },
      "fullStopLossImmediate": {
        "type": [
          "string",
          "null"
        ],
        "title": "Local FSL immediate (%)",
        "default": null,
        "x-display-percent": true
      },
      "fullStopLossClose": {
        "type": [
          "string",
          "null"
        ],
        "title": "Local FSL close (%)",
        "default": null,
        "x-display-percent": true
      },
      "postStopLossReentry": {
        "type": "boolean",
        "title": "Post-stop-loss reentry",
        "default": false
      },
      "stopTradeOnFSL": {
        "type": "boolean",
        "title": "Stop trading on FSL",
        "default": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "model": {
              "const": "BSCALPHA"
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "type": "object",
              "title": "TEF parameters",
              "properties": {
                "HTF_Bias": {
                  "type": "number",
                  "default": 0.0,
                  "minimum": -1.0,
                  "maximum": 1.0
                },
                "HTF_ReversalThreshold_S": {
                  "type": "number",
                  "default": 0.01,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "HTF_ReversalThreshold_L": {
                  "type": "number",
                  "default": 0.01,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "HTF_Strength_S": {
                  "type": "number",
                  "default": 1.0,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "HTF_Strength_L": {
                  "type": "number",
                  "default": 1.0,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "MTF_Bias_S": {
                  "type": "number",
                  "default": 0.0,
                  "minimum": -1.0,
                  "maximum": 1.0
                },
                "MTF_Bias_L": {
                  "type": "number",
                  "default": 0.0,
                  "minimum": -1.0,
                  "maximum": 1.0
                },
                "MTF_ReversalThreshold_Entry_S": {
                  "type": "number",
                  "default": 0.8,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "MTF_ReversalThreshold_Entry_L": {
                  "type": "number",
                  "default": 0.8,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "MTF_ReversalThreshold_Exit_S": {
                  "type": "number",
                  "default": 0.8,
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "MTF_ReversalThreshold_Exit_L": {
                  "type": "number",
                  "default": 0.8,
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "model": {
              "const": "BSCBETA"
            }
          }
        },
