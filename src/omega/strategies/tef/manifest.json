                },
                "MTF_Alpha_Exit_L": {
                  "type": "number",
                  "default": 1.0,
                  "minimum": 0.0,
                  "maximum": 10.0
                },
                "MTF_Beta_Entry_S": {
                  "type": "number",
                  "default": 1.0,
